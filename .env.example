APP_ENV=development
API_PORT=8080
WEB_PORT=5173
CORS_ALLOW_ORIGIN=http://localhost:5173
JWT_SECRET=
JWT_ISSUER=aigc-3d-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
COOKIE_SECURE=false

MYSQL_DATABASE=aigc_platform
MYSQL_USER=aigc
MYSQL_PASSWORD=aigc_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_STREAM=generation_jobs
REDIS_CONSUMER_GROUP=ai-workers
WORKER_INTERNAL_TOKEN=dev-worker-token
GENERATION_JOB_TIMEOUT=15m
GENERATION_PROVIDER=mock
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_TIMEOUT=60
PROVIDER_POLL_INTERVAL=8
PROVIDER_POLL_TIMEOUT=900
TOKENHUB_API_KEY=
HY3D_BASE_URL=https://tokenhub.tencentmaas.com
HY3D_MODEL=hy-3d-3.1
HY3D_ENABLE_PBR=true
HY3D_FACE_COUNT=100000
HY3D_GENERATE_TYPE=normal
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aigc-assets

# Web 容器同源反向代理 API；服务器部署时将 WEB_PORT 设为 80 后可通过 http://<服务器IP> 访问
VITE_API_BASE_URL=
