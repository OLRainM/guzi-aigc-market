        {"term":"立绘","aliases":["全身立绘","角色立绘","character illustration"],"definition":"以完整人物形象为主体、适合展示或后续制作的角色图。","tags":["角色","插画"]},
        {"term":"拆分立绘","aliases":["分层立绘","layered character art"],"definition":"将角色头发、身体、服装和配件分成独立层级的立绘。","tags":["角色","分层","3D参考"]},
        {"term":"表情差分","aliases":["表情变体","expression variants"],"definition":"保持角色外貌一致，仅变化眼睛、嘴型或情绪的多个版本。","tags":["角色","表情"]},
        {"term":"私设","aliases":["自定义设定","personalized setting"],"definition":"用户在已有角色或题材基础上补充、修改的个人设定。","tags":["设定","个性化"]},
        {"term":"同人","aliases":["二次创作","fan creation","fan art"],"definition":"基于已有作品、角色或世界观进行的非官方创作。","tags":["创作类型","版权"],"risk_tags":["copyright_review"]},
        {"term":"原作向","aliases":["遵循原设","canon-oriented"],"definition":"尽量保持原作角色外观、服装和性格特征的创作方向。","tags":["创作类型","一致性"]},
        {"term":"梦向","aliases":["梦女向","梦男向","self-insert"],"definition":"将用户或原创角色与指定角色建立关系的创作方向。","tags":["创作类型","关系设定"],"risk_tags":["relationship_fiction"]},
        {"term":"OOC","aliases":["角色崩坏","out of character"],"definition":"角色行为、表情或气质明显偏离原有设定。","tags":["质量控制","一致性"]},
        {"term":"元气系","aliases":["元气少女","energetic character"],"definition":"动作活泼、表情明亮、姿态开放的角色气质。","tags":["气质","表情"]},
        {"term":"傲娇","aliases":["tsundere"],"definition":"外在表现强硬或嘴硬，但内在存在亲近、害羞或关心。","tags":["气质","性格"]},
        {"term":"三无","aliases":["无口系","kuudere-like"],"definition":"情绪表达克制、表情平静、语言简短的角色气质。","tags":["气质","性格"]},
        {"term":"腹黑","aliases":["表面温和内心强势","scheming character"],"definition":"表面温和或优雅，但具有强烈控制欲或策略性的角色气质。","tags":["气质","性格"]},
        {"term":"病娇","aliases":["yandere"],"definition":"情感强烈、依恋或占有倾向明显的角色性格标签。","tags":["气质","性格","风险关注"],"risk_tags":["emotional_intensity"]},
        {"term":"御姐","aliases":["成熟系女性","onee-san type"],"definition":"偏成熟、从容、自信的女性角色气质。","tags":["气质","角色"]},
