        {"term":"三视图","aliases":["正侧背视图","turnaround sheet"],"definition":"以正面、侧面和背面正交视图完整展示角色或产品结构。","tags":["3D参考","构图"]},
        {"term":"正交视图","aliases":["orthographic view"],"definition":"不产生透视缩放的工程式视图，适合建模和尺寸确认。","tags":["3D参考","构图"]},
        {"term":"A姿势","aliases":["A-pose"],"definition":"双臂自然下垂并略向外张开的中性建模姿势。","tags":["3D参考","姿态"]},
        {"term":"T姿势","aliases":["T-pose"],"definition":"双臂水平展开、便于绑定和检查身体对称性的建模姿势。","tags":["3D参考","姿态"]},
        {"term":"中性站姿","aliases":["neutral pose"],"definition":"双脚稳定站立、动作幅度小、便于观察服装与轮廓的姿态。","tags":["3D参考","姿态"]},
        {"term":"正面全身","aliases":["front full body"],"definition":"从正面完整展示角色头部、身体、鞋子和配件。","tags":["构图","角色"]},
        {"term":"45度视角","aliases":["三分之四视角","three-quarter view"],"definition":"介于正面和侧面的视角，适合同时展示正面细节和体积。","tags":["构图","商品图"]},
        {"term":"动态姿势","aliases":["dynamic pose","action pose"],"definition":"通过重心偏移、肢体曲线和服装飘动表现动作感。","tags":["姿态","动作"]},
        {"term":"S形曲线","aliases":["S-curve pose"],"definition":"身体主轴形成柔和S形，常用于优雅或偶像化姿态。","tags":["姿态","构图"]},
        {"term":"单品展示","aliases":["isolated product shot"],"definition":"画面聚焦一个商品，背景简洁，方便观察尺寸和材质。","tags":["商品图","构图"]},
        {"term":"套装展示","aliases":["set display","bundle shot"],"definition":"多个同系列周边在一个画面中进行组合展示。","tags":["商品图","构图"]},
        {"term":"谷美场景","aliases":["goods display scene"],"definition":"将多个谷子放入桌面、展柜或痛包中进行生活化陈列。","tags":["商品图","场景"]}
      ]
    },
    {
      "category": "model_3d",
      "subcategory": "3D模型约束",
      "items": [
        {"term":"卡通渲染","aliases":["toon shading","NPR"],"definition":"以非真实感渲染方式让3D模型呈现二维动画色块和描边效果。","tags":["3D","渲染"]},
        {"term":"低模","aliases":["low-poly"],"definition":"使用较少多边形保持清晰轮廓和较低文件体积的模型。","tags":["3D","性能"]},
        {"term":"高模雕刻","aliases":["high-poly sculpt"],"definition":"使用较高细分度塑造复杂体积、褶皱和雕刻细节。","tags":["3D","细节"]},
        {"term":"干净拓扑","aliases":["clean topology"],"definition":"边流清晰、结构可控、无明显破面和无意义密集面的网格。","tags":["3D","技术质量"]},
        {"term":"四边面拓扑","aliases":["quad topology"],"definition":"主要由四边形组成、便于细分、变形和后续编辑的网格。","tags":["3D","技术质量"]},
        {"term":"重拓扑","aliases":["retopology"],"definition":"将高模或生成网格重建为更适合编辑、绑定或渲染的拓扑。","tags":["3D","流程"]},
        {"term":"边线循环","aliases":["edge loops"],"definition":"围绕眼睛、嘴、关节或服装结构形成连续可控的边线。","tags":["3D","技术质量"]},
        {"term":"可绑定","aliases":["rig-ready"],"definition":"网格结构适合添加骨骼、权重和姿态控制。","tags":["3D","动画"]},
        {"term":"面部形变","aliases":["facial blendshapes"],"definition":"通过形态键或混合变形控制嘴型、眼睛和表情。","tags":["3D","表情"]},
        {"term":"UV展开","aliases":["UV unwrapped"],"definition":"将三维表面展开为二维纹理坐标，以便贴图和印刷材质定位。","tags":["3D","材质"]},
        {"term":"PBR材质","aliases":["PBR materials","physically based material"],"definition":"使用基础色、金属度、粗糙度和法线等参数描述材质。","tags":["3D","材质"]},
        {"term":"封闭网格","aliases":["watertight mesh"],"definition":"模型表面完全闭合，没有开口，适合实体制造或3D打印。","tags":["3D打印","技术质量"]},
        {"term":"流形网格","aliases":["manifold mesh"],"definition":"每条边和面具有明确邻接关系、适合下游处理的有效网格。","tags":["3D打印","技术质量"]},
        {"term":"无悬浮部件","aliases":["no floating geometry"],"definition":"避免没有连接到主体的孤立几何体。","tags":["3D打印","技术质量"]},
        {"term":"无自相交","aliases":["no self-intersections"],"definition":"避免模型表面彼此穿插，减少切片和渲染错误。","tags":["3D打印","技术质量"]},
        {"term":"稳定底座","aliases":["stable display base"],"definition":"使角色或商品能够独立站立的支撑结构。","tags":["3D打印","展示"]},
        {"term":"最小壁厚","aliases":["minimum wall thickness"],"definition":"制造时需要保持的最小实体厚度，避免薄片断裂。","tags":["3D打印","制造约束"]},
        {"term":"可打印悬垂","aliases":["printable overhangs"],"definition":"控制悬空结构角度和支撑需求，使模型适合实际打印。","tags":["3D打印","制造约束"]},
        {"term":"卡扣连接","aliases":["keyed joints","keyed connection"],"definition":"通过定位凸起、凹槽或插接结构实现分件装配。","tags":["3D打印","结构"]},
        {"term":"分件","aliases":["separated parts","part segmentation"],"definition":"将主体、配件、底座或复杂结构拆成便于生成和制造的独立部件。","tags":["3D打印","结构"]}
      ]
    },
    {
      "category": "material_process",
      "subcategory": "材质与商品工艺",
      "items": [
        {"term":"透明亚克力","aliases":["clear acrylic"],"definition":"具有透明边缘和硬质反光的亚克力材料。","tags":["材质","亚克力"]},
        {"term":"磨砂亚克力","aliases":["frosted acrylic"],"definition":"表面经过磨砂处理、反光较柔和且半透明的亚克力。","tags":["材质","亚克力"]},
        {"term":"彩色透明亚克力","aliases":["tinted transparent acrylic"],"definition":"带有透明彩色基材或渐变色透光效果的亚克力。","tags":["材质","亚克力"]},
        {"term":"软PVC","aliases":["soft PVC"],"definition":"柔软、有弹性、适合挂件或小型立体周边的塑胶材料。","tags":["材质","塑胶"]},
        {"term":"树脂","aliases":["resin"],"definition":"适合雕塑、浇注和手办制作的硬质或半硬质材料。","tags":["材质","手办"]},
        {"term":"毛绒布料","aliases":["plush fabric","minky fabric"],"definition":"具有柔软绒面、纤维方向和填充感的玩偶面料。","tags":["材质","毛绒"]},
        {"term":"滴胶","aliases":["epoxy dome","epoxy resin coating"],"definition":"在印刷图案表面覆盖透明凸起树脂层，形成圆润高光。","tags":["工艺","树脂"]},
        {"term":"闪粉","aliases":["glitter"],"definition":"在透明层或印刷层中加入反光颗粒的装饰效果。","tags":["工艺","闪烁"]},
        {"term":"流沙","aliases":["liquid shaker","floating glitter"],"definition":"将液体和亮片封装在透明腔体中，形成可移动的动态效果。","tags":["工艺","动态"]},
        {"term":"镭射膜","aliases":["holographic film","rainbow foil"],"definition":"在光线下呈现彩虹或角度变化反射的薄膜工艺。","tags":["工艺","镭射"]},
        {"term":"彩虹膜","aliases":["iridescent film"],"definition":"根据观察角度改变颜色和反射强度的膜材。","tags":["工艺","镭射"]},
        {"term":"星闪膜","aliases":["starburst foil"],"definition":"呈现细碎星点或放射闪光的特殊膜材。","tags":["工艺","闪烁"]},
        {"term":"烫金","aliases":["gold foil stamping"],"definition":"使用金色金属箔形成局部高亮文字或装饰。","tags":["印刷","金属光泽"]},
        {"term":"烫银","aliases":["silver foil stamping"],"definition":"使用银色金属箔形成局部高亮文字或装饰。","tags":["印刷","金属光泽"]},
        {"term":"局部UV","aliases":["spot UV"],"definition":"只在指定区域施加高光涂层，形成触感和反射对比。","tags":["印刷","高光"]},
        {"term":"压纹","aliases":["embossing","debossing"],"definition":"通过压制让纸张或材料表面产生凹凸纹理。","tags":["印刷","纹理"]},
        {"term":"浮雕","aliases":["relief"],"definition":"让图案从平面或基材表面凸起，形成浅立体效果。","tags":["工艺","立体"]},
        {"term":"白墨打底","aliases":["white ink backing"],"definition":"在透明基材下增加白墨层，使彩色图案保持饱和度和可见度。","tags":["印刷","亚克力"]},
        {"term":"局部透光","aliases":["selective translucency"],"definition":"指定区域允许光线穿过或呈现半透明效果。","tags":["材质","灯光"]},
        {"term":"异形模切","aliases":["die-cut contour"],"definition":"沿图案外轮廓裁切出非矩形的商品形状。","tags":["加工","结构"]}
      ]
    }
  ]
}
